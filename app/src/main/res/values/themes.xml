<resources>
    <!-- Base application theme. -->
    <style name="Theme.Elet" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <!-- main primary color  dark gray in dark mode -->
        <item name="colorPrimary">@color/Neon</item>
        <!-- top notifications bar color dark gray in dark mode -->
        <item name="colorPrimaryDark">@color/Neon</item>
        <!--  color used for holidays remains the same in all themes-->
        <item name="colorAccent">@color/red_ish</item>
        <item name="textInputStyle">@style/AppTextField</item>
        <item name="colorControlHighlight">@color/darker_lightGray</item>
        <item name="toolbarStyle">@style/MyToolbar</item>
        <!-- text color   should be white in dark mode -->
        <item name="android:textColor">@color/black</item>
        <!-- Week end text color -->
        <item name="android:textColorPrimary">?attr/colorPrimary</item>
        <!-- indicator text color -->
        <item name="android:textColorHighlight">@color/red_ish</item>
        <!-- text color offset -->
        <item name="android:textColorHint">@color/lightGrey</item>
        <!--item name="android:windowBackground">@color/white</item-->
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>
        <item name="bottomSheetDialogTheme">@style/CustomBottomSheetDialog</item>
        <item name="fontFamily">@font/abyssinica</item>
    </style>

    <style name="AppTextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/Neon</item>
        <item name="boxCornerRadiusBottomEnd">2dp</item>
        <item name="borderWidth">1dp</item>
        <item name="color">@color/Neon</item>
    </style>

    <style name="MyToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:gravity">center_vertical</item>
        <item name="android:theme">@style/MyToolbarTheme</item>
    </style>

    <style name="MyToolbarTheme" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="android:textColorPrimary">@color/white</item>
        <item name="textBackground">@color/lightGrey</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="colorControlNormal">@color/black</item>
        <item name="colorControlHighlight">@color/white</item>
        <item name="popupMenuBackground">@color/Neon</item>

    </style>

    <style name="ThemeOverlay.MyApplication.AppWidgetContainer" parent="">
        <item name="appWidgetBackgroundColor">@color/Neon</item>
        <item name="appWidgetTextColor">@color/white</item>
    </style>

    <style name="input_dialog" parent="">
        <item name="cornerSizeTopLeft">10pt</item>
        <item name="cornerSizeTopRight">10pt</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
    <style name="CustomBottomSheetDialog" parent="@style/ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheet</item>
    </style>

    <style name="CustomBottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/CustomShapeAppearanceBottomSheetDialog</item>
    </style>

    <style name="CustomShapeAppearanceBottomSheetDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">5pt</item>
        <item name="cornerSizeTopLeft">5pt</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>
</resources>